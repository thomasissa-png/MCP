  "component": {
    "badge-verified": {
      "background": "{semantic.*.color-verified-bg}",
      "text": "{semantic.*.color-verified-fg}",
      "border": "1px solid {semantic.*.color-verified-border}",
      "radius": "{primitives.radius.full}",
      "padding-x": "{primitives.spacing.sm}",
      "padding-y": "{primitives.spacing.2xs}",
      "font-size": "{primitives.font.size.xs}",
      "font-weight": "{primitives.font.weight.medium}",
      "icon": "check-circle, 14px, couleur = texte"
    },
    "badge-stale": {
      "background": "{semantic.*.color-stale-bg}",
      "text": "{semantic.*.color-stale-fg}",
