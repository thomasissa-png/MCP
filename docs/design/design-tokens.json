      "radius": "{primitives.radius.full}",
      "icon": "clock, 14px, indique 'à revérifier' sans alarmisme"
    },
    "badge-risk": {
      "background": "{semantic.*.color-attention-bg}",
      "text": "{semantic.*.color-attention-fg}",
