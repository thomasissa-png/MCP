# =========================================================================
# Parrainly — variables d'environnement (MODELE). Copier en .env.local (jamais commite).
# Aucune valeur reelle ici. Secrets prod : wrangler secret put / GitHub Actions secrets.
# =========================================================================

# --- Base de donnees (Drizzle, dialecte SQLite) ---
# Dev local (better-sqlite3) : chemin de fichier, prefixe file: optionnel.
DATABASE_URL="file:./drizzle/local.db"
# Prod Cloudflare D1 : PAS de DATABASE_URL — binding D1 injecte via wrangler.toml (env.DB).
# Prod Neon (si bascule Postgres) : DATABASE_URL="postgresql://USER:PASSWORD@HOST/db?sslmode=require"

# --- Application ---
# URL publique de base (generation des liens /r/{token}).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Analytics (data/tracking-plan.md : Plausible + PostHog) ---
# CLIENT (expose au navigateur, charge UNIQUEMENT apres consentement du bandeau cookies) :
#   - Plausible : domaine configure => script mesure d'audience charge apres opt-in.
#   - PostHog client (optionnel) : events produit cote navigateur.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
# SERVEUR (posthog-node, jamais expose au client). Absent = repli journalisation console (pilote) :
# le build et les tests ne dependent d'AUCUN compte externe. Present => capture server-side.
POSTHOG_KEY=""
POSTHOG_HOST="https://eu.i.posthog.com"

# --- Monitoring (post-launch) ---
# Sentry (free tier 5k events/mois) — cote serveur ET client.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# --- Auth parrain (magic link, cercle ferme T&E) ---
# Allowlist stricte : emails des 2 comptes autorises. Defauts .test (pilote) — remplacer par les vraies
# adresses en prod. Le seed renseigne parrain.email a partir de ces memes variables (mapping session->parrain).
AUTH_THOMAS_EMAIL="thomas@parrainly.test"
AUTH_EMMANUEL_EMAIL="emmanuel@parrainly.test"
# Seuils auth CONFIGURABLES (spec auth-parrain-magic-link.md §4).
AUTH_MAGIC_LINK_TTL_MINUTES="15"
AUTH_SESSION_TTL_DAYS="30"
AUTH_MAGIC_LINK_COOLDOWN_SECONDS="60"
AUTH_MAGIC_LINK_MAX_PER_HOUR="5"
# Mailer PLUGGABLE : 'console' (pilote, log le lien dans les logs serveur) ou 'resend' (prod).
MAILER_TRANSPORT="console"
# Transport prod Resend (requis si MAILER_TRANSPORT=resend) :
RESEND_API_KEY=""
MAILER_FROM=""

# --- Confirmation de conversion (US-09) ---
# Fenetre glissante (jours) du garde-fou de plausibilite : confirmations <= redirections (defaut 30, [HYPOTHESE]).
SOCLE_PLAUSIBILITY_WINDOW_DAYS="30"

# --- Socle demandeur (vague 2a) — seuils metier CONFIGURABLES (jamais en dur) ---
# Cle d'auth des routes internes /internal/* (moteur d'arbitrage, job fraicheur).
# Absente en DEV = routes ouvertes (smoke test). Absente en PROD = routes FERMEES (fail-closed, 401).
# En prod : DOIT etre definie (wrangler secret put INTERNAL_API_KEY).
INTERNAL_API_KEY=""
# Anti-abus attribution publique (protection du quota T&E). Rate-limit par source (IP + session anonyme).
SOCLE_ATTRIBUTION_RATE_MAX="10"
SOCLE_ATTRIBUTION_RATE_WINDOW_SECONDS="60"
# Fenetre de dedup serveur : re-demande du meme lien pour la meme offre => lien deja genere (pas de quota consomme).
SOCLE_ATTRIBUTION_DEDUP_WINDOW_SECONDS="30"
# Signalement de lien mort (US-06) : dedup (offre + source/IP) et seuil de re-verification.
SOCLE_SIGNALEMENT_DEDUP_WINDOW_SECONDS="3600"
SOCLE_SIGNALEMENT_REVERIFICATION_THRESHOLD="3"
SOCLE_SIGNALEMENT_REVERIFICATION_WINDOW_SECONDS="604800"
# Contact legal affiche sur les pages CGU / divulgation / mentions / confidentialite. VIDE => lien vers
# le formulaire /rgpd/demande (JAMAIS de crochet placeholder). Valeur reelle a confirmer a la revue juridique finale.
LEGAL_CONTACT_EMAIL=""
# Identite editeur / directeur publication / hebergeur (mentions legales). VIDE => formulation factuelle
# du pilote sans crochet placeholder. Valeurs reelles a renseigner a la revue juridique finale / provisioning infra.
LEGAL_EDITOR_NAME=""
LEGAL_PUBLICATION_DIRECTOR=""
LEGAL_HOST=""
# Longueur du token /r/{token} (defaut 8).
SOCLE_TOKEN_LENGTH="8"
# Fenetre de conversion en jours entre generation et confirmation (defaut 60, [HYPOTHESE]).
SOCLE_CONVERSION_WINDOW_DAYS="60"
# Fraicheur max d'une offre en jours avant passage 'expire' (defaut 30, [HYPOTHESE], US-04).
SOCLE_FRESHNESS_MAX_DAYS="30"
# Programmes non diffusables publiquement (liste separee par virgules). VIDE pour le pilote
# (restriction Trade Republic/Kraken reportee a revue juridique finale). Levier generique pilote par statut.
SOCLE_NON_PUBLIC_PROGRAMS=""
