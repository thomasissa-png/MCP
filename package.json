  "description": "Parrainly — registre de confiance du parrainage, verifie avant d'etre cite par les IA. Squelette technique Phase 2.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
